<Window
    x:Class="ToastifyReloaded.Linux.ToastWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="350"
    Height="78"
    CanResize="False"
    ShowInTaskbar="False"
    Topmost="True"
    SystemDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="Button.track-link">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.track-link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.track-link:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Styles>

  <Border
      x:Name="RootBorder"
      CornerRadius="4"
      BorderThickness="1"
      Padding="5">
    <Grid ColumnDefinitions="60,*" RowDefinitions="*,Auto">
      <Image
          x:Name="ArtworkImage"
          Width="60"
          Height="60"
          Stretch="UniformToFill"
          Grid.RowSpan="2"/>

      <Grid
          Grid.Column="1"
          Margin="8,0,0,0"
          RowDefinitions="Auto,Auto,Auto,*">
        <Button x:Name="TitleLink" Classes="track-link" Click="OnTrackLinkClick">
          <TextBlock
            x:Name="TitleText"
            FontSize="15"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis"/>
        </Button>
        <Button x:Name="ArtistLink" Grid.Row="1" Classes="track-link" Click="OnTrackLinkClick">
          <TextBlock
            x:Name="ArtistText"
            FontSize="12"
            TextTrimming="CharacterEllipsis"/>
        </Button>
        <TextBlock
            x:Name="TimeText"
            Grid.Row="2"
            FontSize="10"
            Opacity="0.85"/>
      </Grid>

      <ProgressBar
          x:Name="ProgressBar"
          Grid.Row="1"
          Grid.Column="1"
          Margin="8,2,0,0"
          Height="3"
          Minimum="0"
          Maximum="1"
          Value="0"/>
    </Grid>
  </Border>
</Window>
